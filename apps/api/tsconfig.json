{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node10 解析在 TS 7 移除；API 产物仍是 CommonJS（package.json 无 type: module），
    // module 与 moduleResolution 必须成对改成 Node16。
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "multer"],
    "outDir": "dist",
    "rootDir": "src",
    "strictPropertyInitialization": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
