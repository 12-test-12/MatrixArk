# 本机 DBX 的 MatrixArk 连接。填入拥有 matrixark_app 权限组的真实登录账号和密码。
DATABASE_URL="postgresql://matrixark_api:YOUR_PASSWORD@127.0.0.1:5432/postgres?schema=public"

# ---- 服务 ----
API_HOST=127.0.0.1
API_PORT=4000
API_ORIGIN="http://localhost:3000"
NODE_ENV=development
PUBLIC_BASE_URL=

# ---- 会话 ----
SESSION_TTL_DAYS=30

# ---- 兼容旧部署。应用凭据优先在工作台「发布账号」填写。 ----
XIAOHONGSHU_APP_ID=
XIAOHONGSHU_APP_SECRET=

# ---- B 站专栏旧版联调配置。网页配置由工作室负责人保存。 ----
BILIBILI_OFFICIAL_ENABLED=false
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
BILIBILI_CREDENTIALS_KEY=

# 可选。默认在持久化存储中生成共用密钥，飞书凭据在工作台填写。
NOTIFICATION_CREDENTIALS_KEY=

# ---- 存储 ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

SANDBOX_CHANNEL=false

# 可选。附加公开 RSS/Atom 订阅的完整 HTTPS 地址，多个地址用逗号隔开。
TOPIC_RSS_URLS=

# 可选。部署管理员允许的额外 AI 接口完整地址，包含 /chat/completions，多个地址用逗号隔开。
TOPIC_AI_ALLOWED_ENDPOINTS=
